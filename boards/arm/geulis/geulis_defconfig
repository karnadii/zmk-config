# SPDX-License-Identifier: MIT

CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_GEULIS=y

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# Enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y

# Hardware driver selection (see boards/arm/geulis/Kconfig):
#   GEULIS_DRIVER_ENCODER       — selects EC11 driver
#   GEULIS_DRIVER_RGB_UNDERGLOW — selects WS2812 + ZMK underglow
# To disable a feature entirely, also flip the matching GEULIS_*_ON
# define in boards/arm/geulis/geulis_options.h from 1 to 0.
CONFIG_GEULIS_DRIVER_ENCODER=y
CONFIG_GEULIS_DRIVER_RGB_UNDERGLOW=y
CONFIG_GEULIS_RGB_UNDERGLOW_AUTO_OFF_USB=y

# EC11 driver must use the global-workqueue trigger (can't be selected
# from a choice symbol via Kconfig `select`).
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# Clock Control
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=n
CONFIG_CLOCK_CONTROL_NRF_K32SRC_30PPM=y

# Connection issue
# CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
CONFIG_BT_CTLR_PHY_2M=n
CONFIG_ZMK_BLE_PASSKEY_ENTRY=n

# SLEEP
CONFIG_ZMK_SLEEP=y
