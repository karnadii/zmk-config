#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

// caps_word override must be a root-level node reference (outside / { })
// Extend continue-list: survive UNDERSCORE, MINUS, BACKSPACE, DELETE
// without dropping out of caps-word mode.

&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>; };

/ {
    // Activate ADJUST layer when LOWER + RAISE are both active

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // J (31) + K (32) -> ESC  (base layer only, 40 ms timeout)

        combo_jk_esc {
            bindings = <&kp ESC>;
            key-positions = <31 32>;
            timeout-ms = <40>;
            layers = <0>;
        };
    };

    behaviors {
        // bspc_del: tap=Backspace | Shift/GUI=Delete
        // Ctrl+Alt excluded so Ctrl+Alt+Delete is unaffected.

        bspc_del: bspc_del {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_LGUI|MOD_RSFT|MOD_RGUI)>;
        };

        // code_fence: types ```<newline><newline>``` then Up arrow
        // so cursor lands on the blank line inside the fence.

        code_fence: code_fence {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <20>;
            tap-ms = <20>;
            bindings =
                <&macro_tap>,
                <&kp GRAVE &kp GRAVE &kp GRAVE>,
                <&macro_tap>,
                <&kp RET>,
                <&macro_tap>,
                <&kp RET>,
                <&macro_tap>,
                <&kp GRAVE &kp GRAVE &kp GRAVE>,
                <&macro_tap>,
                <&kp UP>;
        };

        // btick_code: tap=` | hold=code_fence  (used on LOWER layer only)

        btick_code: btick_code {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&code_fence>, <&kp>;
        };

        // Encoder mouse scroll behaviors
        msc_up_down: msc_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };

        msc_left_right: msc_left_right {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |  gresc |  1   |  2   |  3    |  4    |  5    |                   |  6    |  7    |  8    |  9    |   0   |  DEL  |
            // |  TAB   |  Q   |  W   |  E    |  R    |  T    |                   |  Y    |  U    |  I    |  O    |   P   |   \   |
            // |CAPS_WRD|  A   |  S   |  D    |  F    |  G    |                   |  H    |  J    |  K    |  L    |   ;   |   '   |
            // | SHIFT  |  Z   |  X   |  C    |  V    |  B    |  MUTE  |  | PLAY  |  N    |  M    |  ,    |  .    |   /   | SHIFT |
            //                 | GUI  |  ALT  | CTRL  |LWR/SPC| REPEAT |  |  RET  |RSE/SPC| RCTRL | RALT  | RGUI  |

            bindings = <
&gresc      &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                      &kp N6       &kp N7     &kp N8     &kp N9    &kp N0    &bspc_del
&kp TAB     &kp Q   &kp W     &kp E     &kp R      &kp T                                       &kp Y        &kp U      &kp I      &kp O     &kp P     &kp BACKSLASH
&caps_word  &kp A   &kp S     &kp D     &kp F      &kp G                                       &kp H        &kp J      &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT   &kp Z   &kp X     &kp C     &kp V      &kp B      &kp C_MUTE     &kp C_PP          &kp N        &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                    &kp LGUI  &kp LALT  &kp LCTRL  &lt 1 SPACE &key_repeat   &kp RET           &lt 2 SPACE  &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp C_NEXT C_PREV>;
        };

        lower_layer {
            display-name = "lower";

            // ------------------------------------------------------------------------------------------------------------
            // | `/```  |  F1  |  F2  |  F3   |  F4   |  F5   |                   |  F6   |  F7   |  F8   |  F9   |  F10  |  F11  |
            // |        |  1   |  2   |  3    |  4    |  5    |                   |  6    |  7    |  8    |  9    |   0   |  F12  |
            // |        |  !   |  @   |  #    |  $    |  %    |                   |  ^    |  &    |  *    |  (    |   )   |   |   |
            // |        |  =   |  -   |  +    |  {    |  }    |        |  |       |  [    |  ]    |  ;    |  :    |   \   |       |
            //                 |      |       |       |       |        |  |       |       |       |       |       |

            bindings = <
&btick_code 0 GRAVE  &kp F1     &kp F2     &kp F3    &kp F4    &kp F5                               &kp F6     &kp F7    &kp F8     &kp F9     &kp F10   &kp F11
&trans               &kp N1     &kp N2     &kp N3    &kp N4    &kp N5                               &kp N6     &kp N7    &kp N8     &kp N9     &kp N0    &kp F12
&trans               &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                            &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR   &kp RPAR  &kp PIPE
&trans               &kp EQUAL  &kp MINUS  &kp PLUS  &kp LBRC  &kp RBRC   &trans    &trans          &kp LBKT   &kp RBKT  &kp SEMI   &kp COLON  &kp BSLH  &trans
                                &trans     &trans    &trans    &trans     &trans    &trans          &trans     &trans    &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>, <&inc_dec_kp LC(RIGHT_ARROW) LC(LEFT_ARROW)>;
        };

        raise_layer {
            display-name = "raise";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR  | BT1  | BT2  |  BT3  |  BT4  |  BT5  |                   |       | PSCR  |  INS  | P_BRK | W_DEL |  DEL  |
            // | OUT_TOG|      | MB4  | M_UP  | MB5   |SCRL_UP|                   | PG_UP | W_LFT |   UP  | W_RGT | HOME  |       |
            // |        |      |M_LEFT| M_DOWN|M_RIGHT|SCRL_DN|                   | PG_DN |  LEFT |  DOWN | RIGHT |  END  |       |
            // |        |      | LCLK |  MCLK |  RCLK |       |        |  |       |       |       |       |       |       |       |
            //                 |      |       |       |       |        |  |       |       |       |       |       |

            bindings = <
&bt BT_CLR    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4                      &trans     &kp PRINTSCREEN     &kp INS   &kp PAUSE_BREAK      &kp LC(BACKSPACE)  &kp DEL
&out OUT_TOG  &trans        &mkp MB4        &mmv MOVE_UP    &mkp MB5         &msc SCRL_UP                      &kp PG_UP  &kp LC(LEFT_ARROW)  &kp UP    &kp LC(RIGHT_ARROW)  &kp HOME           &trans
&trans        &trans        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN                    &kp PG_DN  &kp LEFT            &kp DOWN  &kp RIGHT            &kp END            &trans
&trans        &trans        &mkp LCLK       &mkp MCLK       &mkp RCLK        &trans          &trans    &trans  &trans     &trans              &trans    &trans               &trans             &trans
                            &trans          &trans          &trans           &trans          &trans    &trans  &trans     &trans              &trans    &trans
            >;

            sensor-bindings = <&msc_up_down>, <&msc_left_right>;
        };

        adjust_layer {
            display-name = "adjust";

            // ------------------------------------------------------------------------------------------------------------
            // | EP_TOG |      |      |       |       |       |                   |       |       |       |       |       |       |
            // | RESET  |      |      |       |       |       |                   |       |       |       |       |       |       |
            // | BOOTLDR|      |      |       |       |       |                   |       |       |       |       |       |       |
            // | STUDIO |      |      |       |       |       |        |  |       |       |       |       |       |       |       |
            //                 |      |       |       |       |        |  |       |       |       |       |       |       |

            bindings = <
&ext_power EP_TOG  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&sys_reset         &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&bootloader        &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&studio_unlock     &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                           &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_4 {
            status = "reserved";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
