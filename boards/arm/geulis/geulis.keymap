#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define MODS_COMBO (MOD_LSFT|MOD_LGUI|MOD_RSFT|MOD_RGUI)

#define MORPH(name, first, second) \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        bindings = <first>, <second>; \
        #binding-cells = <0>; \
        mods = <(MODS_COMBO)>; \
    };

#define ENCODER_VAR(name, prev_bind, next_bind) \
    name: name { \
        compatible = "zmk,behavior-sensor-rotate-var"; \
        #sensor-binding-cells = <2>; \
        bindings = <prev_bind>, <next_bind>; \
    };

#define ENCODER(name, prev_bind, next_bind) \
    name: name { \
        compatible = "zmk,behavior-sensor-rotate"; \
        #sensor-binding-cells = <0>; \
        bindings = <prev_bind>, <next_bind>; \
    };


&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/*
 * Balanced layer-tap for the inner-thumb Space key.
 * "balanced" flavor only fires the hold (layer-1 entry = functions) once
 * another key is pressed *and* released while Space is held — avoids
 * sticky-Fn when the user pauses briefly on Space.
 */
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};



/ {


    behaviors {
        // Volume and RGB controls
        MORPH(vol_next, &kp C_VOL_UP, &kp C_NEXT)
        MORPH(vol_prev, &kp C_VOL_DN, &kp C_PREV)
        MORPH(bri_i_hue_i, &rgb_ug RGB_BRI, &rgb_ug RGB_HUI)
        MORPH(bri_d_hue_d, &rgb_ug RGB_BRD, &rgb_ug RGB_HUD)

        // Encoders
        ENCODER(media_encoder, &vol_prev, &vol_next)
        ENCODER_VAR(rgb_encoder, &bri_d_hue_d, &bri_i_hue_i)
        ENCODER(bt_encoder, &bt BT_PRV, &bt BT_NXT)
        // Mid encoder: vertical scroll (DOWN/UP arrow) by default, undo/redo on upper layers.
        // Each action is a MORPH (own phandle) so the ENCODER binding can use a
        // bare phandle reference instead of &kp <HID-arithmetic> (which the DTS
        // parser rejects when nested inside a sensor-rotate's bindings).
        MORPH(mid_enc_prev, &kp DOWN, &kp DOWN)
        MORPH(mid_enc_next, &kp UP, &kp UP)
        MORPH(mid_fn_enc_prev, &kp LC(Z), &kp LC(Y))
        MORPH(mid_fn_enc_next, &kp LC(Y), &kp LC(Z))
        ENCODER(mid_enc, &mid_enc_prev, &mid_enc_next)
        ENCODER(mid_fn_enc, &mid_fn_enc_prev, &mid_fn_enc_next)
        // Bot encoder: horizontal scroll (LEFT/RIGHT arrow) by default,
        // browser back/forward on upper layers.
        MORPH(bot_enc_prev, &kp LEFT, &kp LEFT)
        MORPH(bot_enc_next, &kp RIGHT, &kp RIGHT)
        MORPH(bot_fn_enc_prev, &kp C_AC_BACK, &kp C_AC_BACK)
        MORPH(bot_fn_enc_next, &kp C_AC_FORWARD, &kp C_AC_FORWARD)
        ENCODER(bot_enc, &bot_enc_prev, &bot_enc_next)
        ENCODER(bot_fn_enc, &bot_fn_enc_prev, &bot_fn_enc_next)

        // Media controls
        MORPH(f12, &kp F12, &kp C_VOL_UP)
        MORPH(f11, &kp F11, &kp C_VOL_DN)
        MORPH(f10, &kp F10, &kp C_MUTE)
        MORPH(f9, &kp F9, &kp C_NEXT)
        MORPH(f8, &kp F8, &kp C_PP)
        MORPH(f7, &kp F7, &kp C_PREV)
        MORPH(f6, &kp F6, &rgb_ug RGB_BRI)
        MORPH(f5, &kp F5, &rgb_ug RGB_BRD)
        // Default F3/F4 are Mac-style launch shortcuts:
        //   f3 -> Cmd+Tab (App Switcher)
        //   f4 -> Cmd+E (varies by app, e.g. "Use Selection for Find")
        MORPH(f4,      &kp F4, &kp LG(E))
        MORPH(f3,      &kp F3, &kp LG(TAB))
        // Platform-specific alternates, selectable via ZMK Studio:
        //   macOS alternatives (Cmd+LC+Up = Mission Control Show Desktop):
        //     f3_mac -- Cmd+LC+Up (Show Desktop on macOS)
        //     f4_mac -- Cmd+E (Use Selection for Find / open Explorer)
        //   Windows (Win+Tab = Task View, Win+E = File Explorer):
        //     f3_win -- Win+Tab (Task View)
        //     f4_win -- Win+E (File Explorer)
        //   Linux/GNOME (Ubuntu default; Super+Tab = window switcher, Super+E = Files):
        //     f3_tux -- Super+Tab (window switcher)
        //     f4_tux -- Super+E (open Files app)
        // To switch host in ZMK Studio: rebind the F3 / F4 key on the FUN
        // layer (or the SET-layer `&kp LG(TAB)` / `&kp LG(E)` slots) to one
        // of the alternate morphs/labels above.
        MORPH(f3_mac,  &kp F3, &kp LC(UP_ARROW))
        MORPH(f4_mac,  &kp F4, &kp LG(E))
        MORPH(f3_win,  &kp F3, &kp LG(TAB))
        MORPH(f4_win,  &kp F4, &kp LG(E))
        MORPH(f3_tux,  &kp F3, &kp LG(TAB))
        MORPH(f4_tux,  &kp F4, &kp LG(E))
        MORPH(f2, &kp F2, &kp C_BRI_UP)
        MORPH(f1, &kp F1, &kp C_BRI_DN)
        MORPH(bt_rgb_tog, &out OUT_TOG, &rgb_ug RGB_TOG)
        MORPH(bt_rgb_next, &bt BT_NXT, &rgb_ug RGB_EFF)
        MORPH(bt_clr_all, &bt BT_CLR, &bt BT_CLR_ALL)
        MORPH(tilde_power, &kp TILDE, &ext_power EP_TOG)
        MORPH(pp_shut, &kp C_PP, &soft_off)
        MORPH(home_rst, &kp HOME, &sys_reset)
        MORPH(end_boot, &kp END, &bootloader)
        MORPH(pp_mute, &kp C_MUTE, &kp C_PP)

        // Tap-dance layer-locks (user-facing UX for the FUN and SET layers).
        // The two morphs share the same shape: a single tap fires the
        // corresponding &mo N (momentary \u2014 layer active while held), while
        // a double tap toggles the &tog N (lock \u2014 layer stays active until
        // toggled again). Tuning the `tapping-term-ms` controls how quickly
        // the second tap must follow the first to count as a double-tap.
        //   fun_lock: SET 1 = momentary FUN; SET 2 = toggle-lock FUN
        //   set_lock: SET 1 = momentary SET; SET 2 = toggle-lock SET
        fun_lock: fun_lock {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 1>, <&tog 1>;
        };
        set_lock: set_lock {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo 2>, <&tog 2>;
        };
        // Caps Lock: morph — caps_word on plain tap, &kp CAPS when Shift/Cmd
        // is held. This is the original Geulis binding; user benefits from
        // caps-word ergonomics. (No LED indicator on v0.3 — the green LED is
        // reserved for Caps Lock on the main-branch only.)
        MORPH(caps_word_caps, &caps_word, &kp CAPS)
        MORPH(bspc_del, &kp BACKSPACE, &kp DEL)
    };

    combos {
        compatible = "zmk,combos";

        // ============================================================
        // ADMIN COMBOS (hold-2-physical-switches-to-activate)
        // ============================================================
        // All combos below use the "primary" physical switch (pos 32, the
        // Caps Lock position on the chosen physical layout) plus a secondary
        // letter/number. Hold both for ~100 ms to trigger the action.
        //
        // The intentionally dangerous combos (bootloader, sys_reset,
        // soft_off, ext_power EP_*) intentionally do NOT set `layers = <...>`
        // so they stay locked to layer 3 (settings) and cannot fire from
        // the base layer.
        // ============================================================

        // backspace (pos 14) + primary (pos 32) -> unlock ZMK Studio
        COMBO_UNLOCK_STUDIO {
            bindings = <&studio_unlock>;
            key-positions = <14 32>;
        };

        // U (pos 24) + primary -> unlock ZMK Studio (alternate chord)
        COMBO_UNLOCK_STUDIO2 {
            bindings = <&studio_unlock>;
            key-positions = <24 32>;
        };

        // B (pos 50) + primary -> enter bootloader (UF2 mass-storage)
        COMBO_BOOTLOADER {
            bindings = <&bootloader>;
            key-positions = <50 32>;
        };

        // B (pos 51, alternate B) + primary -> enter bootloader (UF2 mass-storage)
        COMBO_BOOTLOADER2 {
            bindings = <&bootloader>;
            key-positions = <51 32>;
        };

        // R (pos 21) + primary -> reset the microcontroller (reboots firmware)
        COMBO_RESET {
            bindings = <&sys_reset>;
            key-positions = <21 32>;
        };

        // S (pos 34) + primary -> soft-off the keyboard (ZMK sleep)
        COMBO_SHUTDOWN {
            bindings = <&soft_off>;
            key-positions = <34 32>;
        };

        // P (pos 27) + primary -> toggle external power (USB VCC)
        COMBO_POWER {
            bindings = <&ext_power EP_TOG>;
            key-positions = <27 32>;
        };

        // 0 (pos 2) + primary -> force external power ON
        COMBO_POWER_ON {
            bindings = <&ext_power EP_ON>;
            key-positions = <2 32>;
            // layers = <2 3>;
        };

        // 1 (pos 11) + primary -> force external power OFF
        COMBO_POWER_OFF {
            bindings = <&ext_power EP_OFF>;
            key-positions = <11 32>;
            // layers = <2 3>;
        };

    };


    keymap {
        compatible = "zmk,keymap";

/*
 * Default layer:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | PP  |   |  ~| |  1  |  2  |  3  |  4  |  5  |  6  |       |  7  |  8  |  9  |  0  |  -  |  =  | Bsp | Del |
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | PgUp|   |  Tab  |  Q  |  W  |  E  |  R  |  T  |         |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |    \     |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | PgDn|   |  Caps   |  A  |  S  |  D  |  F  |  G  |          |  H  |  J  |  K  |  L  |  ;  |  '  |     Enter     |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    Shift   |  Z  |  X  |  C  |  V  |  B  |      |  B  |   N  |  M  |  ,  |  .  |  /  |   Shift   | Del |
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | Ctrl |          |  ALT  |     WIN    | SET |    |    Space     |  FUN  |                       | Ctrl |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 */

        default_layer {
            display-name = "DEF";
            bindings = <
&pp_mute         &gresc             &kp N1    &kp N2    &kp N3      &kp N4      &kp N5      &kp N6             &kp N7     &kp N8          &kp N9       &kp N0       &kp MINUS    &kp EQUAL    &bspc_del    &kp DEL
&kp PAGE_UP      &kp TAB            &kp Q     &kp W     &kp E       &kp R       &kp T                          &kp Y      &kp U           &kp I        &kp O        &kp P        &kp LBKT     &kp RBKT     &kp BACKSLASH
&kp PAGE_DOWN    &caps_word_caps    &kp A     &kp S     &kp D       &kp F       &kp G                                     &kp H           &kp J        &kp K        &kp L        &kp SEMI     &kp SQT      &kp RET
                 &kp LSHFT          &kp Z     &kp X     &kp C       &kp V       &kp B                          &kp B      &kp N           &kp M        &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT    &kp DEL
                 &kp LCTRL                              &kp LALT    &kp LGUI    &set_lock                                 &lt 1 SPACE     &fun_lock                                                        &kp RCTRL
            >;

            sensor-bindings = <&media_encoder>, <&mid_enc>, <&bot_enc>;
        };

/*
 * Function layer:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | MUTE|   |  ~  |  f1 |  f2 |  f3 |  f4 |  f5 |  f6 |       |  f7 |  f8 |  f9 |  f10 | f11 | f12 | --- | --- |
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | HOME|   |  ---  | --- | --- | MUP | --- | --- |         | --- | --- |  ↑  | --- | PRT | INS |  PB  |  ----   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | END |   |  ----   | --- | MLF |  MDW | MRG | --- |          | --- |  ←  |  ↓  |  →  | --- | --- |     -----     |
 *   '-----'   +----------+-----+-----+-----+-----+-------+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    ----    | --- |  LC  |  MC  |  RC | --- |      | --- |  --- | --- | --- | --- | ---  |  -----   | --- |
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | ---- |          |  ---  |     ---    | --- |    |    -----     |  FUN  |                       | ---- |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 */

        functions {
            display-name = "FUN";
            bindings = <
&pp_mute     &gresc    &f1      &f2               &f3               &f4                &f5      &f6        &f7      &f8       &f9         &f10        &f11               &f12          &trans             &trans
&kp HOME     &trans    &none    &none             &mmv MOVE_UP      &none              &none               &none    &none     &kp UP      &none       &kp PRINTSCREEN    &kp INSERT    &kp PAUSE_BREAK    &none
&kp END      &trans    &none    &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_RIGHT    &none                        &none     &kp LEFT    &kp DOWN    &kp RIGHT          &none         &none              &trans
             &trans    &none    &mkp LCLK         &mkp MCLK         &mkp RCLK          &none               &none    &none     &none       &none       &none              &none         &trans             &trans
             &trans                               &trans            &trans             &trans                       &trans    &trans                                                                      &trans
            >;

            sensor-bindings = <&rgb_encoder 0 0>, <&mid_fn_enc>, <&bot_fn_enc>;
        };
/*
 * Settings:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | Off |   | PWR |  ↓  |  ↑  | Tab |  E  | BR- | BR+ |       | PRV | PP | NXT | MUT | V- | V+ |RGB TOG |BT CLR|
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | RST |   |OUT TG| BT0 | BT1 | BT2 | BT3 | BT4 |          | BR+ | HUE+ | SAT+ | SPD+ | --- | --- | --- |  ---   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | BOOT |   |  StU  | --- | --- | --- | --- | --- |          |  BR- | HUE- | SAT- | SPD- | --- | --- |    ---      |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    ---     | --- | --- | --- | --- | --- |      | --- | --- | --- | --- | --- | --- |  ---   |BT CLR  |
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | ---  |         |  ---  |     ---    | ---  |    |    ---      |  ---  |                       | ---  |
 *            '------'          '--------------------------'    '----------------------'                       '-----'
 */

        settings {
            display-name = "SET";
            bindings = <
&soft_off      &tilde_power      &kp C_BRI_DEC    &kp C_BRI_UP    &kp LG(TAB)     &kp LG(E)       &rgb_ug RGB_BRD  &rgb_ug RGB_BRI        &kp C_PREVIOUS      &kp C_PP           &kp C_NEXT         &kp C_MUTE         &kp C_VOL_DN       &kp C_VOL_UP     &rgb_ug RGB_TOG    &bt_clr_all
&sys_reset     &out OUT_TOG      &bt BT_SEL 0     &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                            &rgb_ug RGB_BRI     &rgb_ug RGB_HUI    &rgb_ug RGB_SAI    &rgb_ug RGB_SPI    &none              &none            &none              &rgb_ug RGB_EFF
&bootloader    &studio_unlock    &none            &none           &none           &none           &none                                                       &rgb_ug RGB_BRD    &rgb_ug RGB_HUD    &rgb_ug RGB_SAD    &rgb_ug RGB_SPD    &none            &none              &none
               &trans            &none            &none           &none           &none           &none                                   &none               &none              &none              &none              &none              &none            &none              &bt_clr_all
               &trans                                             &trans          &trans          &trans                                                      &trans              &trans                                                                                      &trans
            >;

             sensor-bindings = <&rgb_encoder 0 0>, <&mid_fn_enc>, <&bot_fn_enc>;
        };

/*
 * Extra1:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | --- |   | --- | --- | --- | --- | --- | --- | --- |       | --- | --- | --- | --- | --- | --- | --- | --- |
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | --- |   |  ---   | --- | --- | --- | --- | --- |         | --- | --- | --- | --- | --- | --- | --- |  ---   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | --- |   |   ---    | --- | --- | --- | --- | --- |          | --- | --- | --- | --- | --- | --- |    ---       |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    ---     | --- | --- | --- | --- | --- |      | --- | --- | --- | --- | --- | --- |   ---    | ---   |
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | ---  |          |  ---  |     ---    | --- |    |    ---      |  ---   |                       | ---  |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 */

        extra1 {
            status = "reserved";
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans                  &trans  &trans  &trans              &trans  &trans                                          &trans
            >;
        };

/*
 * Extra2:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | --- |   | --- | --- | --- | --- | --- | --- | --- |       | --- | --- | --- | --- | --- | --- | --- | --- |
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | --- |   |  ---   | --- | --- | --- | --- | --- |         | --- | --- | --- | --- | --- | --- | --- |  ---   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | --- |   |   ---    | --- | --- | --- | --- | --- |          | --- | --- | --- | --- | --- | --- |    ---       |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    ---     | --- | --- | --- | --- | --- |      | --- | --- | --- | --- | --- | --- |   ---    | ---   |
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | ---  |          |  ---  |     ---    | --- |    |    ---      |  ---    |                      | ---  |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 */

        extra2 {
            status = "reserved";
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans                  &trans  &trans  &trans              &trans  &trans                                          &trans
            >;
        };
    };
};
