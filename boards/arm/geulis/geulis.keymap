#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define MODS_COMBO (MOD_LSFT|MOD_LGUI|MOD_RSFT|MOD_RGUI)

#define MORPH(name, first, second) \
    name: name { \
        compatible = "zmk,behavior-mod-morph"; \
        bindings = <first>, <second>; \
        #binding-cells = <0>; \
        mods = <(MODS_COMBO)>; \
    };

#define ENCODER_VAR(name, prev_bind, next_bind) \
    name: name { \
        compatible = "zmk,behavior-sensor-rotate-var"; \
        #sensor-binding-cells = <2>; \
        bindings = <prev_bind>, <next_bind>; \
    };

#define ENCODER(name, prev_bind, next_bind) \
    name: name { \
        compatible = "zmk,behavior-sensor-rotate"; \
        #sensor-binding-cells = <0>; \
        bindings = <prev_bind>, <next_bind>; \
    };


&caps_word {
    continue-list = <UNDERSCORE MINUS>;
};

/*
 * Balanced layer-tap for the inner-thumb Space key.
 * "balanced" flavor only fires the hold (layer-1 entry = functions) once
 * another key is pressed *and* released while Space is held — avoids
 * sticky-Fn when the user pauses briefly on Space.
 */
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};



/ {

    
    behaviors {
        // Volume and RGB controls
        MORPH(vol_next, &kp C_VOL_UP, &kp C_NEXT)
        MORPH(vol_prev, &kp C_VOL_DN, &kp C_PREV)
        MORPH(bri_i_hue_i, &rgb_ug RGB_BRI, &rgb_ug RGB_HUI)
        MORPH(bri_d_hue_d, &rgb_ug RGB_BRD, &rgb_ug RGB_HUD)

        // Encoders
        ENCODER(media_encoder, &vol_prev, &vol_next)
        ENCODER_VAR(rgb_encoder, &bri_d_hue_d, &bri_i_hue_i)
        ENCODER(bt_encoder, &bt BT_PRV, &bt BT_NXT)
        // Mid encoder: vertical scroll (DOWN/UP arrow) by default, undo/redo on upper layers.
        // Each action is a MORPH (own phandle) so the ENCODER binding can use a
        // bare phandle reference instead of &kp <HID-arithmetic> (which the DTS
        // parser rejects when nested inside a sensor-rotate's bindings).
        MORPH(mid_enc_prev, &kp DOWN, &kp DOWN)
        MORPH(mid_enc_next, &kp UP, &kp UP)
        MORPH(mid_fn_enc_prev, &kp LC(Z), &kp LC(Y))
        MORPH(mid_fn_enc_next, &kp LC(Y), &kp LC(Z))
        ENCODER(mid_enc, &mid_enc_prev, &mid_enc_next)
        ENCODER(mid_fn_enc, &mid_fn_enc_prev, &mid_fn_enc_next)
        // Bot encoder: horizontal scroll (LEFT/RIGHT arrow) by default,
        // browser back/forward on upper layers.
        MORPH(bot_enc_prev, &kp LEFT, &kp LEFT)
        MORPH(bot_enc_next, &kp RIGHT, &kp RIGHT)
        MORPH(bot_fn_enc_prev, &kp C_AC_BACK, &kp C_AC_BACK)
        MORPH(bot_fn_enc_next, &kp C_AC_FORWARD, &kp C_AC_FORWARD)
        ENCODER(bot_enc, &bot_enc_prev, &bot_enc_next)
        ENCODER(bot_fn_enc, &bot_fn_enc_prev, &bot_fn_enc_next)

        // Media controls
        MORPH(bspc_del, &kp BACKSPACE, &kp DEL)
        MORPH(f12, &kp F12, &kp C_VOL_UP)
        MORPH(f11, &kp F11, &kp C_VOL_DN)
        MORPH(f10, &kp F10, &kp C_MUTE)
        MORPH(f9, &kp F9, &kp C_NEXT)
        MORPH(f8, &kp F8, &kp C_PP)
        MORPH(f7, &kp F7, &kp C_PREV)
        MORPH(f6, &kp F6, &rgb_ug RGB_BRI)
        MORPH(f5, &kp F5, &rgb_ug RGB_BRD)
        MORPH(f4, &kp F4, &kp LG(E))
        MORPH(f3, &kp F3, &kp LG(TAB))
        MORPH(f3_mac, &kp F3, &kp LC(UP_ARROW))
        MORPH(f2, &kp F2, &kp C_BRI_UP)
        MORPH(f1, &kp F1, &kp C_BRI_DN)
        MORPH(bt_rgb_tog, &out OUT_TOG, &rgb_ug RGB_TOG)
        MORPH(bt_rgb_next, &bt BT_NXT, &rgb_ug RGB_EFF)
        MORPH(bt_clr_all, &bt BT_CLR, &bt BT_CLR_ALL)
        MORPH(tilde_power, &kp TILDE, &ext_power EP_TOG)
        MORPH(pp_shut, &kp C_PP, &soft_off)
        MORPH(home_rst, &kp HOME, &sys_reset)
        MORPH(end_boot, &kp END, &bootloader)
        MORPH(pp_mute, &kp C_MUTE, &kp C_PP)
        // Caps Lock: morph — caps_word on plain tap, &kp CAPS when Shift/Cmd
        // is held. This is the original Geulis binding; user benefits from
        // caps-word ergonomics. (No LED indicator on v0.3 — the green LED is
        // reserved for Caps Lock on the main-branch only.)
        MORPH(caps_word_caps, &caps_word, &kp CAPS)
    };

    combos {
        compatible = "zmk,combos";

        COMBO_UNLOCK_STUDIO {
            bindings = <&studio_unlock>;
            key-positions = <14 32>;
        };

        COMBO_UNLOCK_STUDIO2 {
            bindings = <&studio_unlock>;
            key-positions = <24 32>;
        };

        // ZMK v0.3 + <behaviors.dtsi> already provides &gresc, &caps_word,
        // &studio_unlock, &bootloader, &sys_reset, &soft_off, &bt (BT_*) — no
        // local redefinitions needed. Custom behaviors below only add what ZMK
        // doesn't ship (mod-morphs, sensor-rotate, custom macros).
        //
        // Dangerous combos intentionally do NOT set `layers = <0 1 2 3>` —
        // they stay locked to layer 3 (settings) so they cannot fire from base.
        COMBO_BOOTLOADER {
            bindings = <&bootloader>;
            key-positions = <50 32>;
        };

        COMBO_BOOTLOADER2 {
            bindings = <&bootloader>;
            key-positions = <51 32>;
        };

        COMBO_RESET {
            bindings = <&sys_reset>;
            key-positions = <21 32>;
        };

        COMBO_SHUTDOWN {
            bindings = <&soft_off>;
            key-positions = <34 32>;
        };

        COMBO_POWER {
            bindings = <&ext_power EP_TOG>;
            key-positions = <27 32>;
        };

        COMBO_INSERT {
            bindings = <&kp INSERT>;
            key-positions = <25 17>;
            // layers = <0 1>;
        };

        COMBO_PRNTSCR {
            bindings = <&kp PRINTSCREEN>;
            key-positions = <27 17>;
            // layers = <0 1>;
        };

        COMBO_PAUSE_BREAK {
            bindings = <&kp PAUSE_BREAK>;
            key-positions = <17 63>;
            // layers = <0 1>;
        };

        COMBO_POWER_ON {
            bindings = <&ext_power EP_ON>;
            key-positions = <2 32>;
            // layers = <2 3>;
        };

        COMBO_POWER_OFF {
            bindings = <&ext_power EP_OFF>;
            key-positions = <11 32>;
            // layers = <2 3>;
        };

        COMBO_WIN_SHUTDOWN {
            bindings = <&win_shutdown>;
            key-positions = <61 63 27>;
        };

        COMBO_WIN_SLEEP {
            bindings = <&win_sleep>;
            key-positions = <61 63 34>;
        };
    };

    macros {
        win_sleep: win_sleep {
            label = "WIN_SLEEP";
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp R>,
                <&macro_release>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp R &kp U &kp N &kp D &kp L &kp L &kp N3 &kp N2>,
                <&macro_tap>,
                <&kp DOT &kp E &kp X &kp E>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_tap>,
                <&kp P &kp O &kp W &kp R &kp P &kp R &kp O &kp F>,
                <&macro_tap>,
                <&kp DOT &kp D &kp L &kp L>,
                <&macro_tap>,
                <&kp COMMA>,
                <&macro_tap>,
                <&kp LS(S) &kp E &kp T >,
                <&macro_tap>,
                <&kp LS(S) &kp U &kp S &kp P &kp E &kp N &kp D>,
                <&macro_tap>,
                <&kp LS(S) &kp T &kp A &kp T &kp E>,
                <&macro_tap>,
                <&kp SPACE &kp N0 &kp COMMA &kp N1 &kp COMMA &kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };

        win_shutdown: win_shutdown {
            label = "WIN_SHUTDOWN";
            compatible = "zmk,behavior-macro";
            wait-ms = <40>;
            tap-ms = <40>;
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp R>,
                <&macro_release>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp S &kp H &kp U &kp T &kp D &kp O &kp W &kp N>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_tap>,
                <&kp FSLH &kp S>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_tap>,
                <&kp FSLH &kp T>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_tap>,
                <&kp RET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

/*
 * Default layer:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | PP  |   |  ~| |  1  |  2  |  3  |  4  |  5  |  6  |       |  7  |  8  |  9  |  0  |  -  |  =  | Bsp | Del |
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | PgUp|   |  Tab  |  Q  |  W  |  E  |  R  |  T  |         |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |    \   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | PgDn|   |  Caps   |  A  |  S  |  D  |  F  |  G  |          |  H  |  J  |  K  |  L  |  ;  |  '  |    Enter     |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    Shift   |  Z  |  X  |  C  |  V  |  B  |      |  B  |   N  |  M  |  ,  |  .  |  /  |   Shift   | Del |
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | Ctrl |          |  ALT  |     WIN    | Fn  |    |    Space     |  WIN  |                       | Ctrl |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 *
 * The Geulis ships a single base layer now. We previously had a separate
 * `macos` and `windows` layer that only differed in the ALT/GUI swap; users
 * switching platforms had to flash two different firmwares. The repo is built
 * with the `studio-rpc-usb-uart` snippet on `default` variant, so modifier
 * positions can be remapped live via ZMK Studio — no flash needed when you
 * plug the keyboard into a different OS.
 *
 * Modifier layout is currently Mac-style (Cmd next to space, Opt further left).
 * To switch to Windows-style with ZMK Studio: remap the inner-thumb positions
 * (Fn row, between Ctrl and Space) so LEFT WIN / LEFT ALT swap, and same on
 * the inner-right side of the thumb.
 */

        default_layer {
            display-name = "Default";
            bindings = <
&pp_mute         &gresc             &kp N1  &kp N2  &kp N3    &kp N4    &kp N5  &kp N6      &kp N7       &kp N8    &kp N9  &kp N0     &kp MINUS  &kp EQUAL  &bspc_del  &kp DEL
&kp PAGE_UP      &kp TAB            &kp Q   &kp W   &kp E     &kp R     &kp T               &kp Y        &kp U     &kp I   &kp O      &kp P      &kp LBKT   &kp RBKT   &kp BACKSLASH
&kp PAGE_DOWN    &caps_word_caps    &kp A   &kp S   &kp D     &kp F     &kp G                            &kp H     &kp J   &kp K      &kp L      &kp SEMI   &kp SQT    &kp RET
                 &kp LSHFT          &kp Z   &kp X   &kp C     &kp V     &kp B               &kp B        &kp N     &kp M   &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT  &kp DEL
                 &kp LCTRL                          &kp LALT  &kp LGUI    &mo 2               &lt 1 SPACE  &kp RGUI                                                      &kp RCTRL
            >;

            sensor-bindings = <&media_encoder>, <&mid_enc>, <&bot_enc>;
        };


        functions {
            display-name = "Functions";
            bindings = <
&pp_mute     &gresc      &f1          &f2          &f3          &f4          &f5          &f6      &f7          &f8      &f9          &f10         &f11         &f12         &kp INSERT    &kp PAUSE_BREAK
&kp HOME     &trans      &none          &none         &mmv MOVE_UP   &none         &none                          &none  &none     &kp UP    &none       &none            &none         &none         &none
&kp END      &key_repeat  &none         &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT  &none                          &none  &kp LEFT  &kp DOWN  &kp RIGHT         &none            &none         &trans
             &trans         &none          &mkp LCLK      &mkp MCLK     &mkp RCLK     &none                  &none  &none   &none     &none     &none            &none       &trans            &trans
             &trans                                    &trans        &trans        &none                  &none  &trans                                                                    &trans
            >;

            sensor-bindings = <&rgb_encoder 0 0>, <&mid_fn_enc>, <&bot_fn_enc>;
        };
/*
 * Settings:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | Off |   | ~/| |  ↓  |  ↑  | Tab |  E  | BR- | BR+ |       | PRV | PP | NXT | MUT | V- | V+ |RGB TOG|BT CLR|
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | RST |   |OUT TG| BT0 | BT1 | BT2 | BT3 | BT4 |         |BR+ |HUE+ |SAT+ |SPD+ | --- | --- | --- |  ---   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | BOOT |   |  StU  | --- | --- | --- | --- | --- |          |BR- |HUE- |SAT- |SPD- | --- | --- |    ---      |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    ---     | --- | --- | --- | --- | --- |      | --- | --- | --- | --- | --- | --- |  ---   |BT CLR  |
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | ---  |         |  ---  |     ---    | ---  |    |    ---      |  ---  |                       | ---  |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 *
 * Settings layer consolidates everything admin-shaped that used to be on the
 * functions layer (BT_SEL 0–4, OUT_TOG, RGB_TOG, RGB_EFF, BT_CLR_ALL, soft_off,
 * sys_reset, bootloader, tilde_power / pp_shut / end_boot / home_rst morphs).
 * Layout stays consistent with the previous settings layout; the only swap
 * is `&ext_power EP_TOG` → `&tilde_power` on row 0 col 1 so the EP toggle
 * also covers the Tilde key on plain tap.
 */

        settings {
            display-name = "Settings";
            bindings = <
&soft_off      &tilde_power  &kp C_BRI_DEC  &kp C_BRI_UP  &kp LG(TAB)   &kp LG(E)     &rgb_ug RGB_BRD  &rgb_ug RGB_BRI      &kp C_PREVIOUS   &kp C_PP         &kp C_NEXT       &kp C_MUTE       &kp C_VOL_DN     &kp C_VOL_UP  &rgb_ug RGB_TOG  &bt_clr_all
&sys_reset     &out OUT_TOG   &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &none            &none         &none            &rgb_ug RGB_EFF
&bootloader    &studio_unlock &none          &none         &none         &none         &none                                                  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &none         &none            &tog 1
               &none          &none          &none         &none         &none         &none                                 &none            &none            &none            &none            &none            &none         &none            &bt_clr_all
               &none                         &none         &none         &none                                 &none            &none                                                                                              &none
            >;

             sensor-bindings = <&rgb_encoder 0 0>, <&mid_fn_enc>, <&bot_fn_enc>;
        };

/*
 * Extra1:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | --- |   | --- | --- | --- | --- | --- | --- | --- |       | --- | --- | --- | --- | --- | --- | --- | --- |
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | --- |   |  ---   | --- | --- | --- | --- | --- |         | --- | --- | --- | --- | --- | --- | --- |  ---   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | --- |   |   ---    | --- | --- | --- | --- | --- |          | --- | --- | --- | --- | --- | --- |    ---       |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    ---     | --- | --- | --- | --- | --- |      | --- | --- | --- | --- | --- | --- |   ---    | ---   | 
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | ---  |          |  ---  |     ---    | --- |    |    ---      |  ---   |                       | ---  |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 */

        extra1 {
            status = "reserved";
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans                  &trans  &trans  &trans              &trans  &trans                                          &trans
            >;
        };

/*
 * Extra2:
 *     .-----.    .----------------------------------------.       .-----------------------------------------------.
 *     | --- |   | --- | --- | --- | --- | --- | --- | --- |       | --- | --- | --- | --- | --- | --- | --- | --- |
 *    .'-----'   +-----+-----+-----+-----+-----+-----+-----'     .-+-----+-----+-----+-----+-----+-----+-----+-----+.
 *    | --- |   |  ---   | --- | --- | --- | --- | --- |         | --- | --- | --- | --- | --- | --- | --- |  ---   |
 *   .------'   +--------+-----+-----+-----+-----+-----+.        '-----+-----+-----+-----+-----+-----+-----+---------+.
 *   | --- |   |   ---    | --- | --- | --- | --- | --- |          | --- | --- | --- | --- | --- | --- |    ---       |
 *   '-----'   +----------+-----+-----+-----+-----+-----+.      .--+-----+-----+-----+-----+-----+-----+--------------+.
 *            |    ---     | --- | --- | --- | --- | --- |      | --- | --- | --- | --- | --- | --- |   ---    | ---   | 
 *            |------+-----+-----+-----+-----+-----+-----+-.    |-----+------+-----+-----+-----+-----+---------+------+'
 *            | ---  |          |  ---  |     ---    | --- |    |    ---      |  ---    |                      | ---  |
 *            '------'          '--------------------------'    '----------------------'                       '------'
 */

        extra2 {
            status = "reserved";
            bindings = <
&trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans    &trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans  &trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
          &trans                  &trans  &trans  &trans              &trans  &trans                                          &trans
            >;
        };
    };
};
