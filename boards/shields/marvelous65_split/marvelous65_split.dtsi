/*
 * Copyright (c) 2024 Ujang Karnadi
 *
 * SPDX-License-Identifier: MIT
 *
 * Marvelous65 Split — shared dtsi for both halves.
 *
 * 16 logical columns (8 left + 8 right) × 5 rows. The right half's
 * overlay sets col-offset = <8> on default_transform so its keys
 * land in columns 8–15. The matrix wiring (col/row gpios) is set in
 * the per-half overlay since the two halves have different pinouts.
 *
 * Both halves have:
 *   - 1 EC11 encoder (left_encoder or right_encoder, only one enabled)
 *   - 1 SSD1306 128x32 OLED on I2C0 @ 0x3C
 *   - 1 WS2812 RGB strip on SPI1
 *   - 1 zmk,ext-power-generic on P1.09
 *
 * Choose half with `-DSHIELD=marvelous65_split_left` or `_right`.
 * Default board is `nrfmicro_13`; override with `--board <name>` for
 * any other Pro Micro pin-compatible controller.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zephyr,display = &oled;
        zmk,underglow = &led_strip;
    };

    // 16 logical cols × 5 rows. The /+/ separator in the map marks the
    // boundary between left half (cols 0–7) and right half (cols 8–15).
    // Both halves use the same 16-col transform; the right half's
    // overlay adds col-offset = <8> so its keys land in cols 8–15.
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <16>;
        rows = <5>;

        // Row 0: 8 left keys (ESC..6) / 8 right keys (7..DEL)
        // Row 1: 7 left (TAB..T)        / 7 right (Y..BSLH)
        // Row 2: 6 left (CAPS..G)       / 8 right (H..C_PP)
        // Row 3: 7 left (LSFT..B)       / 6 right (N..UP)
        // Row 4: 5 left (LCTL..MO3)     / 7 right (SPC..RIGHT)
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15)
RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6)                  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15)
RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)                  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15)
RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7)          RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12)          RC(3,14) RC(3,15)
RC(4,1) RC(4,2) RC(4,3) RC(4,5) RC(4,6)                          RC(4,9)  RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15)
        >;
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        label = "LEFT_ENCODER";
        a-gpios = <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <4>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        label = "RIGHT_ENCODER";
        a-gpios = <&gpio0 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        resolution = <4>;
        status = "disabled";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
    };

    // Node name must match the upstream "EXT_POWER" label to preserve
    // user settings across reflash.
    EXT_POWER {
        compatible = "zmk,ext-power-generic";
        control-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
        init-delay-ms = <300>;
    };
};

&i2c0 {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        label = "DISPLAY";
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        prechargep = <0x22>;
    };
};