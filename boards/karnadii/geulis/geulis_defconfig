#
# Per the ZMK HWMv2 migration guide, this file should NOT include
# CONFIG_SOC_* / CONFIG_BOARD_* selections — those are now driven by
# the board's Kconfig.geulis / Kconfig.board YAML files and the
# board-variant default selection logic.

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# Enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y

# Hardware driver selection (see boards/karnadii/geulis/Kconfig):
#   GEULIS_DRIVER_ENCODER       — selects EC11 driver
#   GEULIS_DRIVER_RGB_UNDERGLOW — selects WS2812 + ZMK underglow
# To disable a feature entirely, also flip the matching GEULIS_*_ON
# define in boards/karnadii/geulis/geulis_options.h from 1 to 0.
CONFIG_GEULIS_DRIVER_ENCODER=y
CONFIG_GEULIS_DRIVER_RGB_UNDERGLOW=y
# RGB is on while USB is plugged in. ZMK's AUTO_OFF_USB symbol name is
# misleading — `y` actually turns RGB OFF when USB is connected. We want
# the opposite, so disable it here.
CONFIG_GEULIS_RGB_UNDERGLOW_AUTO_OFF_USB=n

# RGB underglow tuning. ZMK's BRT_* values are in PERCENT (0–100).
# BRT_MAX=70 keeps 18-LED WS2812 current draw under ~300 mA on USB,
# leaving enough headroom for BLE (~10 mA) inside the USB 500 mA budget.
# Going above ~85 starts to cause USB VBUS sag on some hosts (the LED
# refresh current spikes brown out the USB data lines).
CONFIG_ZMK_RGB_UNDERGLOW_HUE_START=160
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=3
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=40
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MIN=10
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX=70

# EC11 driver must use the global-workqueue trigger (can't be selected
# from a choice symbol via Kconfig `select`).
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# OLED display — SSD1306 128x32 on I2C0 (P0.15 SDA, P0.17 SCL) at
# address 0x3C. Enable ZMK's built-in status screen showing layer,
# battery, output, and WPM widgets. The display is declared in
# geulis_nrf52840_zmk.dts under &i2c0; Zephyr's SSD1306 driver is
# auto-selected by the `solomon,ssd1306fb` compatible.
CONFIG_I2C=y
CONFIG_SSD1306=y
CONFIG_ZMK_DISPLAY=y
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y
CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE=y
CONFIG_ZMK_WIDGET_LAYER_STATUS=y
CONFIG_ZMK_WIDGET_BATTERY_STATUS=y
CONFIG_ZMK_WIDGET_BATTERY_STATUS_SHOW_PERCENTAGE=y
CONFIG_ZMK_WIDGET_OUTPUT_STATUS=y

# Clock Control
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=n
CONFIG_CLOCK_CONTROL_NRF_K32SRC_30PPM=y

# Connection issue
# CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
CONFIG_BT_CTLR_PHY_2M=n
CONFIG_ZMK_BLE_PASSKEY_ENTRY=n

# SLEEP
CONFIG_ZMK_SLEEP=y
